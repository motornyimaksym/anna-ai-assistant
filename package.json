{
  "name": "telegram-booking-assistant",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test scripts/hosting-layout.test.mjs",
    "test:unit": "turbo run test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "pnpm --filter api seed",
    "firebase:emulators": "firebase emulators:start --config firebase/firebase.json",
    "firebase:prepare": "node scripts/check-firebase-web-config.mjs && pnpm exec turbo run build --force && node scripts/prepare-firebase.mjs",
    "firebase:deploy": "pnpm firebase:prepare && npx -y firebase-tools@latest deploy --config firebase/firebase.json"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3"
  }
}
